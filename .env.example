APP_DATA_DIR=.data
PORT=8787
NODE_ENV=development

# Local Vite origin for `npm run dev`. In production, replace this with the
# exact HTTPS app origin; multiple exact origins may be comma-separated.
APP_ORIGIN=http://localhost:5173
# Lax works for the same-site local Vite proxy. Production same-origin may use strict.
# For a separate Android WebView/API origin use none only over HTTPS.
COOKIE_SAMESITE=lax

# Host-managed InvokeLLM-compatible adapter; unavailable if unset.
INVOKE_LLM_URL=
INVOKE_LLM_TOKEN=

# Kimi API key is read by the server only.
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Optional server-side speech adapter. Requests contain text only; no language_code is sent.
TTS_API_URL=
TTS_API_TOKEN=
